# Optional overrides for docker-compose.yml. Copy to .env (git-ignored) and change as needed.
# Every value has a default in docker-compose.yml, so the file is not required.

# PostgreSQL database created on first start and used by the payment router.
POSTGRES_DB=payment_router
POSTGRES_USER=router
POSTGRES_PASSWORD=router

# Host port for the web UI (http://localhost:3000). Change it if 3000 is already in use.
FRONTEND_PORT=3000
