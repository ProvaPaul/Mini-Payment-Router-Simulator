# Optional frontend configuration. Copy to .env.local to use it (.local files are git-ignored).

# Leave unset (default) to call /api through the Vite proxy → http://localhost:8080 (same origin, no CORS).
# Set it to call the Payment Router directly; the router's CORS allow-list must include this page's origin.
# VITE_API_BASE_URL=http://localhost:8080
